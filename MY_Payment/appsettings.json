  "Serilog": {
    "Using": [ "Serilog.Sinks.PostgreSQL.Configuration" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Mvc.RazorPages": "Warning",
        "Microsoft.AspNetCore.Mvc.ViewFeatures": "Warning",
        "Microsoft.AspNetCore.StaticFiles": "Warning",
        "Microsoft.EntityFrameworkCore.Migrations": "Warning",
        "Microsoft.EntityFrameworkCore.Database": "Warning",
        "Microsoft.AspNetCore.Mvc.Infrastructure": "Warning",
        "Microsoft.AspNetCore.RequestLoggingMiddleware": "Warning",
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Warning"
      }
    },
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "SourceContext like 'Microsoft.AspNetCore.%'"
        }
      },
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "SourceContext = 'Serilog.AspNetCore.RequestLoggingMiddleware'"
        }
      }
    ],
    "Enrich": [ "WithMachineName" ],
    "WriteTo": [
      {
        "Name": "PostgreSQL",
        "Args": {
          "connectionString": "Server=209.145.61.216;Port=5432;Database=food_qa;User Id=postgres;Password=tecsolec2018$$",
          "tableName": "\"Logs\"",
          "needAutoCreateTable": true
        }
      }
    ]
  },
  "Columns": {
    "message": {
      "Name": "SinglePropertyColumnWriter",
      "Args": {
        "propertyName": "message",
        "writeMethod": "Raw"
      }
    },
    "level": {
      "Name": "LevelColumnWriter",
      "Args": {
        "renderAsText": true,
        "dbType": "Varchar"
      }
    },
    "raise_date": "TimestampColumnWriter",
    "props_test": {
      "Name": "PropertiesColumnWriter",
      "Args": { "dbType": "Json" }
    },
    "request": {
      "Name": "SinglePropertyColumnWriter",
      "Args": {
        "propertyName": "request",
        "Args": { "dbType": "Json" }
      }
    },
    "exception": {
      "Name": "SinglePropertyColumnWriter",
      "Args": {
        "propertyName": "exception",
        "Args": { "dbType": "Json" }
      }
    },
    "response": {
      "Name": "SinglePropertyColumnWriter",
      "Args": {
        "propertyName": "response",
        "Args": { "dbType": "Json" }
      }
    },
    "event": {
      "Name": "SinglePropertyColumnWriter",
      "Args": {
        "propertyName": "event",
        "writeMethod": "Raw"
      }
    }
  }
}